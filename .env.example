# ==========================================
# 환경 변수 예시 파일
# 이 파일을 복사하여 .env.local로 이름을 변경하세요
# ==========================================

# 📌 Next.js 기본 설정
# NEXT_PUBLIC_* 접두사가 붙은 변수는 클라이언트에서 접근 가능

# 사이트 URL (프로덕션 배포 시 변경)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# 📌 Convex (필수)
# ==========================================
# ⚠️ NEXT_PUBLIC_CONVEX_URL이 없으면 빌드가 실패합니다.
#    (No address provided to ConvexReactClient)
#    Vercel 배포 시에도 프로젝트 설정 > Environment Variables에 반드시 추가하세요.
# 값 확인: `npx convex dev` 실행 후 .env.local에 자동 생성됨
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# ==========================================
# 📌 백엔드 설정 (필요 시 추가)
# ==========================================

# 예시: 데이터베이스 연결
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# 예시: Supabase
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# 📌 외부 서비스 API 키 (필요 시 추가)
# ==========================================

# 한국수출입은행 환율 API
# 발급: https://www.koreaexim.go.kr/ir/HPHKIR020M01
KOREAEXIM_API_KEY=your-api-key-here

# Google Maps (경로 지도 표시용)
# 발급: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 쿠아이디100 (kuaidi100) 택배 API
# 발급: https://www.kuaidi100.com/
KUAIDI100_SECRET_KEY=your-secret-key
KUAIDI100_SECRET_SECRET=your-secret-secret
KUAIDI100_SECRET_SIGN=your-secret-sign
KUAIDI100_PRICE_API_KEY=your-price-api-key

# 예시: 이미지 업로드 (Cloudinary)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# 예시: 이메일 발송 (Resend)
# RESEND_API_KEY=your-resend-api-key

# ==========================================
# 📌 인증 설정 (필요 시 추가)
# ==========================================

# 예시: NextAuth
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key

# 예시: OAuth (Google)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
